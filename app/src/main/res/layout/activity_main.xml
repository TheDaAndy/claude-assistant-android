<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_instructions"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/default_assistant_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/default_assistant_setup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/ankai_connection_heading"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ankai_connection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ankai_not_connected"
            android:textColor="@color/text_secondary" />

        <ProgressBar
            android:id="@+id/ankai_connection_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:id="@+id/ankai_instance_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="none"
            android:hint="@string/ankai_instance_url"
            android:inputType="textUri"
            android:singleLine="true" />

        <EditText
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:id="@+id/ankai_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="username"
            android:hint="@string/ankai_username"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:id="@+id/ankai_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/ankai_password"
            android:inputType="textPassword"
            android:singleLine="true" />

        <Button
            android:id="@+id/ankai_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ankai_connect" />

        <TextView
            android:id="@+id/ankai_default_project_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ankai_default_project"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/ankai_default_project"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <Button
            android:id="@+id/ankai_disconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ankai_disconnect"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ankai_connection_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B00020"
            android:visibility="gone" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="Gerät mit Ankaï koppeln"
            android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/device_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Nicht gekoppelt" android:textColor="@color/text_secondary" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Freigabe wie Secrets: global, für deinen Nutzer, für mehrere Projekte oder einen Chat. Einstellungsseiten öffnen sich erst nach deiner Bestätigung am Handy. Über Bedienungshilfe kannst du das Handy ohne Root und WLAN-Debugging steuern. Shizuku bleibt optional für Shell-Befehle."
            android:textColor="@color/text_secondary" android:layout_marginTop="8dp" />
        <Button android:id="@+id/device_pair" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gerät koppeln und Freigabe wählen" />
        <Button android:id="@+id/device_scope" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gerätefreigabe ändern" android:visibility="gone" />
        <Button android:id="@+id/device_install" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apps über Ankaï installieren" />
        <Button android:id="@+id/device_ui" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Handy steuern ohne Root" />
                <Button android:id="@+id/device_maximum" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Optional: ADB über Shizuku" android:visibility="gone" />
        <Switch android:textColor="@color/text_primary" android:id="@+id/device_enabled" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Gerätezugriff im Hintergrund aktiv" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Aktiv: sichtbare Benachrichtigung mit Pause. Ohne Wake-Lock; bei Netzfehlern längere Wartezeiten. Android kann den Kanal im Energiesparmodus unterbrechen. Nach Neustart wieder manuell aktivieren."
            android:textColor="@color/text_secondary" android:textSize="12sp" />
        <Button android:id="@+id/device_revoke" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gerätekopplung widerrufen" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/playback_heading"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Switch
            android:textColor="@color/text_primary"
            android:id="@+id/ankai_autoplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/playback_autoplay" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/playback_server_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
