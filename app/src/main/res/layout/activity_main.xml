<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Willkommen! Um Claude Assistant zu nutzen:\n\n1. Setze diese App als Standard-Assistent\n   (Einstellungen > Apps > Standard-Apps > Digitaler Assistent)\n\n2. Drücke lange auf die Home-Taste\n\n3. Oder füge das Quick Settings Tile hinzu"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"/>

</LinearLayout>
